# Resend API Key - Get yours at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email addresses
FROM_EMAIL=welcome@baed.site
NOTIFY_EMAIL=signup@baed.site

# Upstash Redis - Get credentials at https://console.upstash.com/redis
# Create a database, then copy the REST URL and token
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here
